{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://family-agent.local/family-spec.schema.json",
  "title": "Family Agent spec",
  "description": "Declarative description of a parametric Revit family. Units are millimetres, Z is up, the family origin sits at the centre of the footprint on the floor. Any numeric field accepts a number or an expression string such as \"[Casing Length] / 2\".",
  "type": "object",
  "required": ["name", "category", "parameters", "parts"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "name": { "type": "string", "description": "Family name, also used for the .rfa file name." },
    "typeName": { "type": "string", "description": "Revit type name created inside the family." },
    "category": {
      "type": "string",
      "enum": [
        "Mechanical Equipment",
        "Duct Fitting",
        "Duct Elbow",
        "Duct Transition",
        "Duct Tee",
        "Duct Cross",
        "Pipe Fitting",
        "Generic Model",
        "Plumbing Fixture",
        "Electrical Equipment",
        "Lighting Fixture",
        "Specialty Equipment",
        "Furniture",
        "Casework",
        "Door",
        "Window",
        "Structural Framing",
        "Structural Column",
        "Structural Foundation",
        "Site",
        "Planting",
        "Entourage",
        "Data Device"
      ]
    },
    "template": { "type": "string", "description": "Optional template key override." },
    "units": { "const": "mm" },
    "revitVersion": { "type": "string" },
    "lod": { "enum": [200, 300, 350, 400] },
    "description": { "type": "string" },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string" },
          "type": { "enum": ["Length", "Angle", "Number", "Integer", "Text", "YesNo"] },
          "group": {
            "enum": [
              "Dimensions",
              "Constraints",
              "Data",
              "Identity Data",
              "Graphics",
              "Materials and Finishes",
              "Mechanical",
              "Electrical",
              "Plumbing",
              "Energy Analysis",
              "Structural",
              "Construction",
              "Visibility",
              "Fire Protection",
              "General",
              "Other"
            ]
          },
          "value": { "type": ["number", "string", "boolean"] },
          "formula": {
            "type": ["string", "null"],
            "description": "Revit compatible formula. Reference parameters with [Param Name]."
          },
          "instance": { "type": "boolean" },
          "description": { "type": "string" },
          "axis": {
            "enum": ["x", "y", "z"],
            "description": "Explicit axis a Length parameter measures; overrides the name heuristic."
          }
        }
      }
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "color": { "type": "string" },
          "metalness": { "type": "number" },
          "roughness": { "type": "number" }
        }
      }
    },
    "connectors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "systemType", "shape", "direction", "origin"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "systemType": {
            "enum": [
              "SupplyAir",
              "ReturnAir",
              "ExhaustAir",
              "HydronicSupply",
              "HydronicReturn",
              "Sanitary",
              "DomesticColdWater",
              "DomesticHotWater",
              "Electrical",
              "Supply Air",
              "Return Air",
              "Exhaust Air",
              "Other Air",
              "Hydronic Supply",
              "Hydronic Return",
              "Domestic Cold Water",
              "Domestic Hot Water",
              "Power - Unbalanced",
              "Power - Balanced",
              "Fire Protection Wet",
              "Fire Protection Dry",
              "Fire Protection Preaction",
              "Fire Protection Other"
            ]
          },
          "shape": { "enum": ["round", "rectangular"] },
          "direction": { "enum": ["in", "out", "bidirectional"] },
          "origin": { "$ref": "#/$defs/vec3" },
          "directionVector": { "$ref": "#/$defs/vec3" },
          "width": { "$ref": "#/$defs/numeric" },
          "height": { "$ref": "#/$defs/numeric" },
          "diameter": { "$ref": "#/$defs/numeric" },
          "flow": { "$ref": "#/$defs/numeric" },
          "flowUnit": { "enum": ["L/s", "m3/h", "CFM"] },
          "pressureDrop": { "$ref": "#/$defs/numeric" }
        }
      }
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["solid"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "material": { "type": "string" },
          "color": { "type": "string" },
          "solid": { "$ref": "#/$defs/solid" },
          "cuts": { "type": "array", "items": { "$ref": "#/$defs/solid" } },
          "array": {
            "type": "object",
            "required": ["count", "spacing"],
            "properties": {
              "count": {
                "type": ["integer", "string"],
                "description": "Whole number, or an expression that resolves to one, e.g. \"[Fin Count]\".",
                "minimum": 1,
                "maximum": 500
              },
              "axis": { "enum": ["x", "y", "z"] },
              "spacing": { "type": ["number", "string"] }
            }
          },
          "anchor": {
            "type": "object",
            "description": "Pins which face is locked to the reference planes, per axis.",
            "properties": {
              "x": { "enum": ["min", "max"] },
              "y": { "enum": ["min", "max"] },
              "z": { "enum": ["min", "max"] }
            }
          }
        }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "numeric": { "type": ["number", "string"] },
    "vec3": {
      "type": "object",
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "$ref": "#/$defs/numeric" },
        "y": { "$ref": "#/$defs/numeric" },
        "z": { "$ref": "#/$defs/numeric" }
      }
    },
    "solid": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "origin", "size"],
          "properties": {
            "kind": { "const": "box" },
            "origin": {
              "$ref": "#/$defs/vec3",
              "description": "Centre of the bottom face."
            },
            "size": { "$ref": "#/$defs/vec3" },
            "rotationZ": { "$ref": "#/$defs/numeric" },
            "cornerRadius": {
              "$ref": "#/$defs/numeric",
              "description": "Rounds the four vertical corners, in millimetres. Clamped to half the footprint."
            }
          }
        },
        {
          "type": "object",
          "required": ["kind", "base", "radius", "height"],
          "properties": {
            "kind": { "const": "cylinder" },
            "base": { "$ref": "#/$defs/vec3", "description": "Centre of the base face." },
            "radius": { "$ref": "#/$defs/numeric" },
            "innerRadius": { "$ref": "#/$defs/numeric" },
            "height": { "$ref": "#/$defs/numeric", "description": "May be negative to extrude backwards." },
            "axis": { "enum": ["x", "y", "z"] },
            "segments": { "type": "integer", "minimum": 12, "maximum": 96 }
          }
        },
        {
          "type": "object",
          "required": ["kind", "base", "radiusBottom", "radiusTop", "height"],
          "properties": {
            "kind": { "const": "frustum" },
            "base": { "$ref": "#/$defs/vec3", "description": "Centre of the base face." },
            "radiusBottom": { "$ref": "#/$defs/numeric" },
            "radiusTop": { "$ref": "#/$defs/numeric", "description": "Radius at the far end. 0 makes a cone." },
            "height": { "$ref": "#/$defs/numeric", "description": "May be negative to extrude backwards." },
            "axis": { "enum": ["x", "y", "z"] },
            "segments": { "type": "integer", "minimum": 12, "maximum": 96 }
          }
        },
        {
          "type": "object",
          "required": ["kind", "center", "radius", "tubeRadius"],
          "properties": {
            "kind": { "const": "bend" },
            "center": { "$ref": "#/$defs/vec3", "description": "Point on the revolution axis." },
            "radius": { "$ref": "#/$defs/numeric", "description": "Distance from the axis to the tube centreline." },
            "tubeRadius": { "$ref": "#/$defs/numeric" },
            "angle": { "$ref": "#/$defs/numeric", "description": "Sweep angle in degrees. Default 90." },
            "startAngle": { "$ref": "#/$defs/numeric", "description": "Start rotation around the axis, in degrees." },
            "plane": { "enum": ["xy", "xz", "yz"] },
            "segments": { "type": "integer", "minimum": 8, "maximum": 96 }
          }
        },
        {
          "type": "object",
          "required": ["kind", "points"],
          "properties": {
            "kind": { "const": "revolve" },
            "axis": { "enum": ["x", "y", "z"], "description": "Axis of revolution. Default z." },
            "origin": { "$ref": "#/$defs/vec3", "description": "Point on the revolution axis." },
            "points": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": { "$ref": "#/$defs/numeric" }
              },
              "description": "Closed polygon profile in (radial, height) coordinates where radial >= 0."
            },
            "angle": { "$ref": "#/$defs/numeric", "description": "Revolution sweep angle in degrees. Default 360." },
            "startAngle": { "$ref": "#/$defs/numeric", "description": "Start angle in degrees. Default 0." },
            "segments": { "type": "integer", "minimum": 12, "maximum": 96 }
          }
        },
        {
          "type": "object",
          "required": ["kind", "start", "end", "radius"],
          "properties": {
            "kind": { "const": "tube" },
            "start": { "$ref": "#/$defs/vec3", "description": "Centre of the start face." },
            "end": { "$ref": "#/$defs/vec3", "description": "Centre of the end face." },
            "radius": { "$ref": "#/$defs/numeric" },
            "innerRadius": {
              "$ref": "#/$defs/numeric",
              "description": "Optional inner radius; makes the tube a hollow pipe."
            },
            "segments": { "type": "integer", "minimum": 12, "maximum": 96 }
          }
        },
        {
          "type": "object",
          "required": ["kind", "plane", "points", "from", "to"],
          "properties": {
            "kind": { "const": "prism" },
            "plane": { "enum": ["xy", "xz", "yz"] },
            "points": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": { "$ref": "#/$defs/numeric" }
              }
            },
            "holes": {
              "type": "array",
              "description": "Inner loops cut out of the extrusion, same coordinate order as points.",
              "items": {
                "type": "array",
                "minItems": 3,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": { "$ref": "#/$defs/numeric" }
                }
              }
            },
            "from": { "$ref": "#/$defs/numeric" },
            "to": { "$ref": "#/$defs/numeric" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "sections"],
          "properties": {
            "kind": { "const": "loft" },
            "axis": { "enum": ["x", "y", "z"], "description": "Axis the sections are stacked along. Default z." },
            "segments": { "type": "integer", "minimum": 8, "maximum": 96 },
            "sections": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "required": ["at", "profile"],
                "properties": {
                  "at": { "$ref": "#/$defs/numeric", "description": "Position along the loft axis. Must increase." },
                  "profile": { "$ref": "#/$defs/loftProfile" }
                }
              }
            }
          }
        }
      ]
    },
    "loftProfile": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "radius"],
          "properties": {
            "kind": { "const": "circle" },
            "radius": { "$ref": "#/$defs/numeric" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "width", "height"],
          "properties": {
            "kind": { "const": "rect" },
            "width": { "$ref": "#/$defs/numeric" },
            "height": { "$ref": "#/$defs/numeric" },
            "cornerRadius": { "$ref": "#/$defs/numeric" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "points"],
          "properties": {
            "kind": { "const": "polygon" },
            "points": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": { "$ref": "#/$defs/numeric" }
              }
            }
          }
        }
      ]
    }
  }
}

# ---- Design agent ---------------------------------------------------------
# commandcode = run the local Command Code CLI in headless mode (uses your login)
# openai      = call an OpenAI compatible chat completions endpoint
AGENT_PROVIDER=commandcode
COMMAND_CODE_BIN=cmdc
# A Command Code API key (commandcode.ai → Studio → API keys) lets the CLI run without
# `cmd login`. The studio can also take it in the API-key dialog; it is passed to the
# CLI process as COMMAND_CODE_API_KEY and never written to disk by the server.
# COMMAND_CODE_API_KEY=
# COMMAND_CODE_MODEL=
# off | low | medium | high | max. Leave empty for the model's own default;
# "off"/"low" are fastest, "high"/"max" trade time for reasoning quality.
# COMMAND_CODE_EFFORT wins over AGENT_BUILD_EFFORT when set.
# COMMAND_CODE_EFFORT=off
# Reasoning effort for build/repair turns when COMMAND_CODE_EFFORT is empty.
AGENT_BUILD_EFFORT=low
# CLI design runs skip skill discovery (faster startup). AGENT_CLI_NO_SKILLS=0 keeps it.
AGENT_CLI_NO_SKILLS=1
# AGENT_CLI_SAFE_MODE=1 adds `--safe-mode` (built-in mods only) to every design turn.
# AGENT_CLI_SAFE_MODE=0
# Direct API streams tokens; a socket with no new token for this long is dead.
AGENT_STREAM_IDLE_MS=90000
# Per model call budget (ms). AGENT_TIMEOUT is the legacy single-call fallback.
# A new, long brief is split into skeleton -> connectors -> materials; each step
# has its own budget, and the whole request is capped by AGENT_TOTAL_TIMEOUT.
AGENT_TIMEOUT=240000
# Skeleton pass (geometry + parameters) of a new family.
AGENT_STEP_TIMEOUT=240000
# Connector / material / edit passes.
AGENT_EDIT_TIMEOUT=120000
# Hard ceiling for ONE model call. A stale AGENT_TIMEOUT=600000 no longer means a
# ten-minute wait: the turn is cut here, then a sectioned brief is rebuilt section
# by section instead of retrying the same over-long prompt.
AGENT_MAX_TURN_TIMEOUT=480000
# Whole request, all steps together.
AGENT_TOTAL_TIMEOUT=900000
# A dropped SSE socket (reload, Vite restart, sleep) keeps the design running this
# long; a studio poll during that window saves the run instead of cancelling it.
AGENT_RECONNECT_GRACE_MS=15000
# A new brief longer than this many characters is split into steps.
AGENT_SPLIT_THRESHOLD=3000
# Transient provider errors (429/500/502/503/504, "high demand", ECONNRESET) are
# retried with backoff: 2 s, 5 s, 12 s (jitter added, Retry-After honoured).
AGENT_RETRY_MAX=3
AGENT_RETRY_BASE_MS=2000
# A provider that is overloaded before any spec exists (503 burst) is retried at the
# request level after these waits instead of failing the job and asking the user.
AGENT_REQUEST_RETRY_DELAYS=20000,45000
# Fallback chain for API callers that do not pick a model. The studio always sends
# the model chosen in the dropdown and that choice is used as-is (no silent switch).
# AGENT_FALLBACK_MODELS=deepseek/deepseek-v4-flash,deepseek/deepseek-v4.1-flash

# ---- Model listing ---------------------------------------------------------
# `cmdc --list-models` can take 15-20 s on a cold start. Below this the studio
# silently loses every CLI model from the dropdown.
# AGENT_LIST_TIMEOUT=45000

# ---- Request router -------------------------------------------------------
# 0 = old behaviour (every request goes to one model with the whole spec).
# Leaves 1 = deterministic fast-edit, patch with a compact prompt, and a single
# stronger repair pass only when errors survive.
# AGENT_ROUTER=1
# Per-tier models. Empty = cheapest / medium / strongest model this machine can run.
# AGENT_TIER1_MODEL=deepseek/deepseek-v4.1-flash
# AGENT_TIER2_MODEL=codex:gpt-6-astra:medium
# AGENT_TIER3_MODEL=codex:gpt-6-astra:high
# Prompt caps per tier (characters).
# AGENT_PROMPT_MAX_TIER1=12000
# AGENT_PROMPT_MAX_TIER2=26000
# AGENT_PROMPT_MAX_TIER3=40000

# ---- Requirement checklist + templates ------------------------------------
# Stable pipeline (default): one model, one conversation, up to 3 repair turns.
# Templates, tier routing, checklist supplement rounds, vision evidence, rule
# packs and plausibility repairs only run when this is 1.
# AGENT_EXPERIMENTAL_PIPELINE=1
# A creation request is turned into a checklist (parts/connectors/parameters/
# materials) before the model runs, and the result is verified against it.
# Cable-ladder templates (tee/elbow/cross) are drawn locally: 0 model calls.
# AGENT_TEMPLATE=0   # disable templates and always use the model

# ---- Photos + PDF catalogues (evidence) -----------------------------------
# The vision model reads product photos and catalogue pages; without one the
# studio still parses the text and warns "Không có model vision".
# AGENT_VISION_MODEL=gpt-4o
# Rendering catalogue pages to images needs two optional packages. Text-only
# catalogues work without them:
#   npm install --workspace server pdfjs-dist @napi-rs/canvas
# Learned / edited rule packs live here and are never committed:
#   server/rules/learned/   server/rules/overrides/

# ---- OpenAI compatible endpoint (only when AGENT_PROVIDER=openai) ---------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=8000

# ---- Revit bridge ---------------------------------------------------------
# Started automatically by the Family Agent add-in inside Revit 2024.
REVIT_BRIDGE_URL=http://127.0.0.1:8765
REVIT_BRIDGE_TIMEOUT=300000
# Optional shared secret. Set the same value as the FAMILY_AGENT_TOKEN environment
# variable in the Revit process; every build then needs the matching header.
# REVIT_BRIDGE_TOKEN=
# Open Revit automatically when "Build Revit family" is pressed (0 = never).
REVIT_AUTO_START=1
REVIT_VERSION=2024
# REVIT_EXE=C:\Program Files\Autodesk\Revit 2024\Revit.exe
REVIT_START_TIMEOUT=240000

# ---- Studio ---------------------------------------------------------------
PORT=8787
# Loopback only by default. Set HOST=0.0.0.0 (and ALLOWED_HOSTS=your-ip) only when
# you really want the studio reachable from another machine.
HOST=127.0.0.1
# ALLOWED_HOSTS=192.168.1.20
# FAMILY_OUT_DIR=C:\Users\you\Documents\FamilyAgent\out
# FAMILY_QUEUE_DIR=C:\Users\you\Documents\FamilyAgent\queue

# Stable design pipeline budgets (extra calls after the first answer, per turn)
# AGENT_REPAIR_MAX=2
# AGENT_SUPPLEMENT_MAX=2
# AGENT_LAYOUT_MAX=1
# AGENT_PROSE_MAX=1
# AGENT_TIMEOUT_RETRY_MAX=1
# AGENT_TURN_CALLS_MAX=6

{
  "name": "family-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "web",
    "server"
  ],
  "scripts": {
    "dev": "npm run build:core && node scripts/dev.mjs",
    "build:core": "npm run build -w @family/spec-core",
    "build": "npm run build:core && npm run build -w web",
    "start": "node server/src/index.js",
    "test": "npm run build:core && npm run test -w @family/spec-core && npm run test -w server && npm run test -w web && npm run addin:test",
    "eval": "npm run build:core && node scripts/eval.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:server": "npm run test -w server",
    "test:web": "npm run test -w web",
    "test:e2e": "playwright test",
    "addin": "dotnet build revit-addin/FamilyAgent.Addin/FamilyAgent.Addin.csproj -c Release",
    "addin:install": "powershell -NoProfile -ExecutionPolicy Bypass -File revit-addin/install.ps1",
    "addin:test": "dotnet run --project revit-addin/FamilyAgent.SelfTest/FamilyAgent.SelfTest.csproj -c Release"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "jsonrepair": "^3.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.1"
  }
}
